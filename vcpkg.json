{
  "name": "a3texture",
  "version": "1.0.0",
  "description": "Native C++ PAA converter for Arma 3 textures",
  "dependencies": [
    "libsquish",
    "lzo",
    "libpng",
    "tiff",
    "nlohmann-json",
    "stb",
    {
      "name": "imgui",
      "features": [
        "opengl3-binding",
        "glfw-binding"
      ]
    },
    {
      "name": "glfw3",
      "features": [
        "wayland"
      ],
      "platform": "linux"
    },
    {
      "name": "glfw3",
      "platform": "!linux"
    },
    "glad",
    "portable-file-dialogs"
  ],
  "builtin-baseline": "271a5b8850aa50f9a40269cbf3cf414b36e333d6"
}
